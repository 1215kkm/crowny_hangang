generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ── 사용자 ──
model User {
  id            String   @id @default(uuid())
  firebaseUid   String   @unique @map("firebase_uid")
  nickname      String
  avatarIcon    String   @default("person") @map("avatar_icon")
  gradientType  String   @default("purple") @map("gradient_type")
  oneLiner      String?  @map("one_liner")
  trustLevel    Int      @default(0) @map("trust_level")
  hangangTemp   Float    @default(36.5) @map("hangang_temp")
  meetupCount   Int      @default(0) @map("meetup_count")
  languages     String[] @default(["KR"])
  contactStage  Int      @default(1) @map("contact_stage")

  // 위치 (PostGIS)
  latitude      Float?
  longitude     Float?
  district      String?  @default("yeouido")
  activity      String?  // chimaek, running, walk, picnic, pet, bike, photo
  activityLabel String?  @map("activity_label")
  statusMessage String?  @map("status_message")
  isOnline      Boolean  @default(false) @map("is_online")
  lastSeenAt    DateTime? @map("last_seen_at")

  // 외부 연락처 (Stage 3)
  kakaoId       String?  @map("kakao_id")
  instagramId   String?  @map("instagram_id")
  phoneNumber   String?  @map("phone_number")

  // 프로필 (Stage 4)
  realName      String?  @map("real_name")
  job           String?
  interests     String[]

  // 설정
  locationSharing    Boolean @default(true) @map("location_sharing")
  pushNotification   Boolean @default(true) @map("push_notification")
  matchNotification  Boolean @default(true) @map("match_notification")
  chatTranslation    Boolean @default(false) @map("chat_translation")
  language           String  @default("ko")

  // 별명 변경
  lastNicknameChange DateTime? @map("last_nickname_change")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // 관계
  sentWaves       Wave[]        @relation("SentWaves")
  receivedWaves   Wave[]        @relation("ReceivedWaves")
  mannerTagsGiven MannerTag[]   @relation("TagGiver")
  mannerTagsReceived MannerTag[] @relation("TagReceiver")
  chatRooms1      ChatRoom[]    @relation("ChatUser1")
  chatRooms2      ChatRoom[]    @relation("ChatUser2")
  messages        ChatMessage[]
  eventParticipants EventParticipant[]
  boardPosts      BoardPost[]
  boardComments   BoardComment[]
  boardLikes      BoardLike[]
  orders          Order[]
  reports         Report[]      @relation("Reporter")
  reported        Report[]      @relation("Reported")
  blocks          Block[]       @relation("Blocker")
  blocked         Block[]       @relation("Blocked")

  @@map("users")
}

// ── 매칭 (손 흔들기) ──
model Wave {
  id          String    @id @default(uuid())
  senderId    String    @map("sender_id")
  receiverId  String    @map("receiver_id")
  status      String    @default("pending") // pending, accepted, declined, expired
  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  sender   User @relation("SentWaves", fields: [senderId], references: [id])
  receiver User @relation("ReceivedWaves", fields: [receiverId], references: [id])

  // 매칭 성사 시 미션 세션 생성
  missionSession MissionSession?

  @@map("waves")
}

// ── 매너 태그 ──
model MannerTag {
  id         String   @id @default(uuid())
  giverId    String   @map("giver_id")
  receiverId String   @map("receiver_id")
  tag        String   // time_keeper, fun_talker, mood_maker, considerate, food_sharer
  createdAt  DateTime @default(now()) @map("created_at")

  giver    User @relation("TagGiver", fields: [giverId], references: [id])
  receiver User @relation("TagReceiver", fields: [receiverId], references: [id])

  @@unique([giverId, receiverId, tag])
  @@map("manner_tags")
}

// ── 미션 세션 ──
model MissionSession {
  id            String   @id @default(uuid())
  waveId        String   @unique @map("wave_id")
  currentPhase  Int      @default(0) @map("current_phase")
  currentMission Int     @default(0) @map("current_mission")
  difficulty    String   @default("normal") // easy, normal, hard
  status        String   @default("active") // active, paused, completed, abandoned
  startedAt     DateTime @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")
  timeoutMinutes Int     @default(60) @map("timeout_minutes")

  wave Wave @relation(fields: [waveId], references: [id])
  completedMissions MissionCompletion[]

  @@map("mission_sessions")
}

model MissionCompletion {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  missionId String   @map("mission_id") // missions.json의 id
  completed Boolean  @default(true)
  skipped   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  session MissionSession @relation(fields: [sessionId], references: [id])

  @@map("mission_completions")
}

// ── 채팅 ──
model ChatRoom {
  id        String   @id @default(uuid())
  user1Id   String   @map("user1_id")
  user2Id   String   @map("user2_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user1    User          @relation("ChatUser1", fields: [user1Id], references: [id])
  user2    User          @relation("ChatUser2", fields: [user2Id], references: [id])
  messages ChatMessage[]

  @@unique([user1Id, user2Id])
  @@map("chat_rooms")
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  senderId  String   @map("sender_id")
  content   String
  type      String   @default("text") // text, image, voice, mood_card, system
  createdAt DateTime @default(now()) @map("created_at")

  room   ChatRoom @relation(fields: [roomId], references: [id])
  sender User     @relation(fields: [senderId], references: [id])

  @@map("chat_messages")
}

// ── 이벤트/번개 모임 ──
model Event {
  id            String   @id @default(uuid())
  creatorId     String   @map("creator_id")
  title         String
  description   String?
  icon          String   @default("event")
  gradientType  String   @default("purple") @map("gradient_type")
  type          String   @default("flash") // flash, regular, seasonal, theme
  district      String
  location      String
  latitude      Float?
  longitude     Float?
  startTime     DateTime @map("start_time")
  endTime       DateTime? @map("end_time")
  maxPeople     Int      @map("max_people")
  status        String   @default("open") // open, full, started, ended, cancelled
  createdAt     DateTime @default(now()) @map("created_at")

  participants EventParticipant[]

  @@map("events")
}

model EventParticipant {
  id       String   @id @default(uuid())
  eventId  String   @map("event_id")
  userId   String   @map("user_id")
  rsvp     String   @default("confirmed") // confirmed, interested, maybe
  joinedAt DateTime @default(now()) @map("joined_at")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_participants")
}

// ── 게시판 ──
model BoardPost {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  district  String   // yeouido, ttukseom, banpo, etc.
  category  String   @default("free") // free, info, food, photo, question
  title     String
  content   String
  imageUrls String[] @map("image_urls")
  viewCount Int      @default(0) @map("view_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author   User           @relation(fields: [authorId], references: [id])
  comments BoardComment[]
  likes    BoardLike[]

  @@map("board_posts")
}

model BoardComment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  content   String
  parentId  String?  @map("parent_id") // 대댓글
  createdAt DateTime @default(now()) @map("created_at")

  post   BoardPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])
  parent BoardComment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies BoardComment[] @relation("CommentReplies")

  @@map("board_comments")
}

model BoardLike {
  id     String @id @default(uuid())
  postId String @map("post_id")
  userId String @map("user_id")

  post BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@map("board_likes")
}

// ── 커머스 (숨김 상태로 준비) ──
model Order {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  items           Json     // [{itemId, name, price, quantity}]
  totalPrice      Int      @map("total_price")
  deliveryFee     Int      @default(0) @map("delivery_fee")
  status          String   @default("pending") // pending, preparing, delivering, completed, cancelled
  district        String
  deliveryAddress String?  @map("delivery_address")
  isGift          Boolean  @default(false) @map("is_gift")
  recipientId     String?  @map("recipient_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("orders")
}

// ── 신고/차단 ──
model Report {
  id         String   @id @default(uuid())
  reporterId String   @map("reporter_id")
  reportedId String   @map("reported_id")
  reason     String
  detail     String?
  status     String   @default("pending") // pending, reviewed, resolved
  createdAt  DateTime @default(now()) @map("created_at")

  reporter User @relation("Reporter", fields: [reporterId], references: [id])
  reported User @relation("Reported", fields: [reportedId], references: [id])

  @@map("reports")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@map("blocks")
}
